# Web Development .gitignore

# Python Core
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env*
.env.local
.env*.local
.venv
env/
venv/
ENV/

# Web frameworks
# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# JavaScript/Node.js (for full-stack projects)
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
/build
dist
dist-ssr
*.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Next.js
/.next/
/out/

# Testing
/coverage

# Vercel
.vercel

# Databases
*.sqlite
db.sqlite
cache.db

# Supabase
supabase/.branches
supabase/.temp
supabase/**/*.env

# Security
*.pem
*.key
*.token
oauth.json
*auth*.json

# Static files and uploads
uploads/
files/
temp/
workspace/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Package managers
#uv.lock
#poetry.lock
#Pipfile.lock