# Data Science .gitignore

# Python Core
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Data Science specific
# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# Data files
data/*
!data/.gitkeep
datasets/
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# Model files
models/
checkpoints/
*.model
*.sav
*.bin

# Results and outputs
results/
outputs/
figures/
plots/
artifacts/

# Temporary files
temp/
tmp/
cache/
*.cache

# Logs
*.log
logs/
mlruns/
wandb/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# Streamlit
**/secrets*.toml

# ML frameworks
# TensorBoard
runs/
logs/

# MLflow
mlruns/
mlartifacts/

# Weights & Biases
wandb/

# DVC
.dvc/
.dvcignore

# Security
*.pem
*.key
*.token
oauth.json
*auth*.json

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Package managers
#uv.lock
#poetry.lock
.pdm.toml
.pdm-python